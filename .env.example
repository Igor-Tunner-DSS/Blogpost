# Copie para .env e preencha. NUNCA versione o arquivo .env.
# Porta do servidor Node.js (hospedagens costumam definir PORT automaticamente).
PORT=3000

# Variáveis PÚBLICAS (vão para o navegador via /config.js).
# Painel Supabase > Project Settings > API.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use somente a chave "anon" (legacy) ou "publishable" (sb_publishable_...).
# NUNCA use service_role / secret aqui: o servidor se recusa a iniciar se detectar uma.
SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
